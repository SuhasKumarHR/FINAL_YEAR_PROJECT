FROM python:3.12-slim

# Install git (for cloning & GitPython) and Node.js (for JS syntax checking)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy agent source code and entrypoint
COPY repo_prep_agent.py .
COPY analysis_agent.py .
COPY healing_agent.py .
COPY git_agent.py .
COPY worker_entrypoint.py .

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "worker_entrypoint.py"]
